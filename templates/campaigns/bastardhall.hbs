              <div><p>Изыскание</p><h2>{{selectedInvestigation.title}}</h2></div>
              <div class="bh-investigation-summary">
                {{#if selectedInvestigation.hasLevel}}<span title="Рекомендуемый уровень сложности проверок">Проверки · ур. {{selectedInvestigation.level}}</span>{{/if}}
                <strong>{{selectedInvestigation.totalPoints}} / {{selectedInvestigation.maxPoints}} ОИ</strong>
              </div>
            </header>
             <div class="bh-investigation-sources">
               {{#each selectedInvestigation.sources}}
                 <article class="{{#unless visible}}is-hidden{{/unless}}">
                   <header><h3>{{name}}</h3><div class="bh-investigation-source-heading-actions"><span>{{points}} / {{maxPoints}} ОИ</span>{{#if @root.isGM}}<button type="button" class="bh-investigation-source-visibility" data-action="toggle-investigation-source-visibility" data-investigation-id="{{investigationId}}" data-source-id="{{id}}" title="{{#if visible}}Скрыть источник от игроков{{else}}Показать источник игрокам{{/if}}" aria-label="{{#if visible}}Скрыть источник от игроков{{else}}Показать источник игрокам{{/if}}"><i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>{{/if}}</div></header>
                   {{#if description}}<div class="bh-investigation-description">{{{description}}}</div>{{/if}}
                   {{#if checks}}<div class="bh-investigation-checks"><h4><i class="fa-solid fa-dice-d20"></i> Проверки изыскания</h4>{{{checks}}}</div>{{/if}}
                </article>
              {{else}}
                <p class="bh-empty">В журнале нет вложенных секций <code>section.read</code>.</p>
              {{/each}}
            </div>
            <section class="bh-investigation-revelations">
              <h3><i class="fa-solid fa-lightbulb"></i> Откровения</h3>
              <div class="bh-investigation-revelation-list">
                {{#each selectedInvestigation.revelations}}
                  <article class="{{#unless unlocked}}is-locked{{/unless}}"><strong>{{threshold}} ОИ</strong><div>{{#if unlocked}}{{{content}}}{{else}}<i class="fa-solid fa-lock"></i> Пока не открыто{{/if}}</div></article>
                {{else}}
                  <p class="bh-empty">Открытых откровений пока нет.</p>
                {{/each}}
              </div>
            </section>
          {{else}}
            <div class="bh-sidequest-empty-detail"><i class="fa-solid fa-magnifying-glass-chart"></i><p>Выберите изыскание слева.</p></div>
          {{/if}}
        </section>
      </div>
      {{else}}
      {{#if showSideQuests}}
      <div class="bh-sidequest-view">
        <aside class="bh-panel bh-sidequest-sidebar">
          <header class="bh-sidequest-list-header">
            <button type="button" class="bh-sidequest-icon-button" data-action="add-side-quest" title="Добавить сайд-квест" aria-label="Добавить сайд-квест"><i class="fa-solid fa-plus"></i></button>
            {{#if isGM}}
              <button type="button" class="bh-sidequest-icon-button" data-action="refresh-side-quests" title="Обновить связанные квесты из журналов" aria-label="Обновить связанные квесты из журналов"><i class="fa-solid fa-arrows-rotate"></i></button>
