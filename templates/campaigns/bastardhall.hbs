                          {{#if hasPreviousPortrait}}<button type="button" class="bh-family-control" data-action="step-family-portrait" data-family-section="customHeirs" data-slot-id="{{id}}" data-direction="-1" title="Предыдущая версия портрета" aria-label="Предыдущая версия портрета"><i class="fa-solid fa-chevron-left"></i></button>{{/if}}
                          {{#if hasNextPortrait}}<button type="button" class="bh-family-control" data-action="step-family-portrait" data-family-section="customHeirs" data-slot-id="{{id}}" data-direction="1" title="Следующая версия портрета" aria-label="Следующая версия портрета"><i class="fa-solid fa-chevron-right"></i></button>{{/if}}
                        </div>
                      {{/if}}
                      {{#if img}}<button type="button" class="bh-family-control bh-family-expand" data-action="expand-family-portrait" data-image="{{img}}" data-title="{{name}}" title="Развернуть портрет" aria-label="Развернуть портрет"><i class="fa-solid fa-expand"></i></button>{{/if}}
                    </div>
