                  {{#if canDelete}}<button type="button" class="bh-sidequest-icon-button bh-sidequest-note-delete" data-action="delete-side-quest-note" data-quest-id="{{questId}}" data-note-id="{{id}}" title="Удалить заметку" aria-label="Удалить заметку"><i class="fa-solid fa-trash"></i></button>{{/if}}
                </article>
              {{else}}
                <p class="bh-empty">Заметок пока нет. Игроки и мастер могут добавить первую.</p>
              {{/each}}
            </div>
          {{else}}
            <div class="bh-sidequest-empty-detail"><i class="fa-solid fa-scroll"></i><p>Выберите сайд-квест слева.</p></div>
          {{/if}}
        </section>
      </div>
      {{else}}
      <div class="bh-config-view">
        <form class="bh-config-form">
