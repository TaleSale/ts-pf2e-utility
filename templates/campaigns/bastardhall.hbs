              {{#if hasDividerBefore}}
                <div class="bh-sidequest-list-divider" aria-hidden="true"></div>
              {{/if}}
              <article class="bh-sidequest-list-item {{#if selected}}is-selected{{/if}} {{#if hidden}}is-hidden{{/if}} {{#if completed}}is-completed{{/if}} {{#if failed}}is-failed{{/if}}" data-action="select-side-quest" data-quest-id="{{id}}">
                <button type="button" class="bh-sidequest-select" data-action="select-side-quest" data-quest-id="{{id}}">
                  <span>{{#if hidden}}<i class="fa-solid fa-eye-slash" title="Скрыт от игроков"></i>{{/if}}<strong>{{title}}</strong></span>
