<div class="bh-sheet">
  <header class="bh-header">
    <div class="bh-title-lock"><i class="fa-solid fa-castle"></i></div>
    <div>
      <p class="bh-kicker">Проклятый бастион богохульства</p>
      <h1>Бастардхолл</h1>
    </div>
    <div class="bh-header-actions">
      {{#if isGM}}
        {{#if showConfig}}
        <button type="button" class="bh-settings-button bh-reset-button" data-action="reset-sheet" title="Сбросить Лист Бастардхолла">
          <i class="fa-solid fa-arrow-rotate-left"></i>
        </button>
        {{/if}}
        <button type="button" class="bh-settings-button" data-action="{{#if showConfig}}close-settings{{else}}open-settings{{/if}}" title="{{#if showConfig}}Вернуться к листу{{else}}Настройки Бастардхолла{{/if}}">
          <i class="fa-solid {{#if showConfig}}fa-arrow-left{{else}}fa-gear{{/if}}"></i>
        </button>
        <button type="button" class="bh-settings-button bh-broadcast-button" data-action="broadcast-sheet" title="Открыть текущую вкладку у игроков" aria-label="Открыть текущую вкладку у игроков">
          <i class="fa-solid fa-eye"></i>
        </button>
      {{/if}}
      <div class="bh-climate-badge {{#unless daytime}}is-night{{/unless}}">
        <i class="fa-solid {{#if daytime}}fa-sun{{else}}fa-moon{{/if}}"></i>
        <span>{{climateLabel}}</span>
        <small>{{currentTime}}</small>
      </div>
    </div>
  </header>

  {{#unless showConfig}}
    <nav class="bh-view-tabs">
      <button type="button" class="{{#if showMain}}active{{/if}}" data-view="main"><i class="fa-solid fa-landmark"></i> Главная</button>
      {{#if showCookingTab}}<button type="button" class="{{#if showCooking}}active{{/if}}" data-view="cooking"><i class="fa-solid fa-utensils"></i> Готовка и Блага</button>{{/if}}
      <button type="button" class="{{#if showInventory}}active{{/if}}" data-view="inventory"><i class="fa-solid fa-box-archive"></i> Инвентарь</button>
      <button type="button" class="{{#if showInvestigations}}active{{/if}}" data-view="investigations"><i class="fa-solid fa-magnifying-glass-chart"></i> Изыскания</button>
      <button type="button" class="{{#if showSideQuests}}active{{/if}}" data-view="side-quests"><i class="fa-solid fa-list-check"></i> Сайд-квесты</button>
      <button type="button" class="{{#if showFamilyTree}}active{{/if}}" data-view="family-tree"><i class="fa-solid fa-people-roof"></i> Древо Арудора</button>
    </nav>
  {{/unless}}

  <section class="bh-body">
    {{#if showMain}}
    <div class="bh-tracker-tab">
      <div class="bh-column">
        <section class="bh-panel bh-climate-panel">
          <h2><i class="fa-solid fa-cloud-moon"></i> Климат</h2>
          <div class="bh-climate-stage"><span>Этап</span><strong>{{climateStage.label}}</strong></div>
          <p class="bh-climate-description">{{climateStage.description}}</p>
          <div class="bh-day-range"><span>Восход — закат</span><strong>{{climateStage.sunriseLabel}} — {{climateStage.sunsetLabel}}</strong></div>
          <div class="bh-day-length"><span>День: {{climateStage.dayDurationLabel}} ч.</span><span>Ночь: {{climateStage.nightDurationLabel}} ч.</span></div>
          <div class="bh-weather-status"><i class="fa-solid {{#if daytime}}fa-sun{{else}}fa-moon{{/if}}"></i><span>Сейчас: <strong>{{climateLabel}}</strong></span></div>
          {{#if hasOutdoorPenalty}}
            <div class="bh-outdoor-penalty {{#if data.climate.outdoorPenaltyActive}}is-active{{/if}}">
              <label title="{{outdoorPenaltyDescription}}"><input type="checkbox" name="outdoorPenaltyActive" {{#if data.climate.outdoorPenaltyActive}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}> <strong>Непогода на улице</strong></label>
              <span>{{outdoorPenaltyDescription}}</span>
            </div>
          {{/if}}
          {{#if climateStage.lightning}}
            {{#if isGM}}
              <button type="button" class="bh-lightning-button" data-action="tower-lightning"><i class="fa-solid fa-bolt-lightning"></i> Удар молнии</button>
            {{/if}}
          {{/if}}
          {{#if data.climate.stormActive}}
            <div class="bh-storm-info"><i class="fa-solid fa-cloud-bolt"></i><div><strong>Шторм</strong>{{#if data.climate.storm.description}}<p>{{data.climate.storm.description}}</p>{{/if}}</div></div>
          {{/if}}
        </section>

        <section class="bh-panel">
          <h2><i class="fa-solid fa-map-location-dot"></i> Доступные зоны</h2>
          <div class="bh-area-grid">
            {{#each areas}}
              <div class="bh-area {{#if wide}}is-wide{{/if}} {{#if unlocked}}is-unlocked{{/if}}"><i class="fa-solid {{#if unlocked}}fa-square-check{{else}}fa-square{{/if}}"></i><span>{{name}}</span></div>
            {{/each}}
          </div>
        </section>

        <section class="bh-panel bh-research-panel">
          <h2><i class="fa-solid fa-magnifying-glass-chart"></i> Изыскания</h2>
          <div class="bh-research-grid">
            {{#each research}}
              <div class="bh-research-row">
                <span title="{{#if ../isGM}}{{name}}{{else}}{{displayName}}{{/if}}">{{displayName}}</span>
                {{#if ../isGM}}{{#if managedByInvestigation}}<span class="bh-research-linked" title="Сумма счётчиков источников во вкладке «Изыскания»"><i class="fa-solid fa-link"></i></span>{{else}}<button type="button" data-research-step="-1" data-index="{{index}}"><i class="fa-solid fa-caret-down"></i></button>{{/if}}{{/if}}
                <strong>{{pointsLabel}}</strong>
                {{#if ../isGM}}{{#if managedByInvestigation}}<span class="bh-research-linked" title="Изменяется только мастером у источников изыскания"><i class="fa-solid fa-link"></i></span>{{else}}<button type="button" data-research-step="1" data-index="{{index}}"><i class="fa-solid fa-caret-up"></i></button>{{/if}}{{/if}}
              </div>
            {{/each}}
          </div>
          {{#if researchBonuses}}
            <div class="bh-research-bonuses">
              <h3><i class="fa-solid fa-award"></i> Открытые бонусы</h3>
              {{#each researchBonuses}}
                <article>
                  <header><strong>{{topicName}}</strong><span>{{threshold}} ОИ</span></header>
                  <p>{{description}}</p>
                </article>
              {{/each}}
            </div>
          {{/if}}
        </section>
      </div>

      <div class="bh-column">
        <section class="bh-panel bh-phantom-panel">
          <h2><i class="fa-solid fa-ghost"></i> Фантомы Майсерин</h2>
          <div class="bh-phantom-list">
            {{#each visiblePhantoms}}
              <article class="bh-phantom">
                <header>
                  <div><strong>{{name}}</strong><small>{{role}}</small></div>
                  <div class="bh-phantom-status">
                    {{#if found}}<b>Ранг {{rank}}</b>{{else}}<b class="is-missing">Не найден</b>{{/if}}
                    {{#if ../isGM}}<button type="button" data-action="toggle-phantom" data-index="{{phantomIndex}}" title="{{#if found}}Отметить ненайденным{{else}}Разблокировать фантома{{/if}}"><i class="fa-solid {{#if found}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>{{/if}}
                  </div>
                </header>
                {{#if canAuskenRunes}}
                  <div class="bh-phantom-actions">
                    <button type="button" data-phantom-action="ausken-runes" data-phantom="{{id}}" title="Получить до {{auskenRuneLimit}} рун Аускена в день"><i class="fa-solid fa-hammer"></i><span>Руны ×{{auskenRuneLimit}}</span></button>
                  </div>
                {{/if}}
                {{#if canEsmiraBooks}}
                  <div class="bh-phantom-actions">
                    <button type="button" data-phantom-action="esmira-books" data-phantom="{{id}}" title="Взять один переносной комплект книг Эсмиры"><i class="fa-solid fa-books"></i><span>Книги Эсмиры</span></button>
                  </div>
                {{/if}}
                <div class="bh-rank-list">
                  {{#each rankRows}}
                    <div class="bh-rank {{#if achieved}}is-achieved{{/if}} {{#if current}}is-current{{/if}}">
                      <span class="bh-rank-number">{{rank}}</span>
                      {{#if achieved}}<span class="bh-rank-heart {{tier}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}</span>{{/if}}
                      <p>{{#if bonus}}{{bonus}}{{else}}—{{/if}}</p>
                    </div>
                  {{/each}}
                </div>
              </article>
            {{else}}
              <p class="bh-empty">Фантомы Майсерин ещё не найдены.</p>
            {{/each}}
          </div>
        </section>

        {{#if showServantBlock}}
        <section class="bh-panel bh-servant-panel">
          <h2><i class="fa-solid fa-bell-concierge"></i> Фантомы-Слуги</h2>
          <div class="bh-servant-list">
            {{#each visibleServantPhantoms}}
              <article class="bh-servant {{#if active}}is-active{{/if}}">
                <header>
                  <div><strong>{{name}}</strong><small>{{location}}</small></div>
                  {{#if ../isGM}}
                    <label class="bh-servant-toggle"><input type="checkbox" data-action="toggle-servant" data-servant="{{id}}" {{#if active}}checked{{/if}}> <span>Активны для игроков</span></label>
                  {{else}}
                    <span class="bh-servant-ready"><i class="fa-solid fa-circle-check"></i> Помогают группе</span>
                  {{/if}}
                </header>
                <p>{{description}}</p>
              </article>
            {{/each}}
          </div>
        </section>
        {{/if}}
      </div>
    </div>

    {{else}}
      {{#if showCooking}}
      <div class="bh-cooking-view">
        <header class="bh-cooking-heading">
          <div><p>Ежедневные приготовления Бастардхолла</p><h2>Готовка и Блага</h2></div>
          <span><i class="fa-solid fa-sun"></i> Состояние обновляется по мировому дню</span>
        </header>

        <section class="bh-daily-section">
          <div class="bh-section-title"><i class="fa-solid fa-utensils"></i><div><h2>Готовка</h2><p>Выберите получателя для каждого доступного помощника. Для Арона и пекарей можно выбрать двух персонажей: порции распределяются поровну.</p></div></div>
          <div class="bh-daily-grid">
            {{#if aronCooking}}
              <article class="bh-daily-card is-active">
                <header><div><strong>Арон Мордримус</strong><small>Трактирщик · ранг {{aronCooking.rank}}</small></div><span>{{#if aronCooking.canDrinks}}до {{aronCooking.limit}} в день{{else}}Напитки не открыты{{/if}}</span></header>
                {{#if aronCooking.canDrinks}}
                  <div class="bh-aron-selections">
                    {{#each aronCooking.selections}}<label><span>Напиток {{index}}</span><select data-aron-item><option value="">Загрузка списка…</option></select><span>Получатель</span><select data-preparation-target="aron"><option value="">— персонаж не выбран —</option>{{#each @root.recipientCharacters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>{{/each}}
                  </div>
                  <p class="bh-daily-note">Напитки получают признак «насыщенный». Общий лимит действует на всю группу.</p>
                {{else}}
                  <p class="bh-daily-note">Арон начнёт готовить напитки после достижения 1-го ранга.</p>
                {{/if}}
                {{#if aronCooking.canCounteract}}
                  <div class="bh-phantom-actions bh-aron-actions">
                    <button type="button" data-phantom-action="aron-counteract" data-phantom="aron" title="Проверка противодействия со средним модификатором группы"><i class="fa-solid fa-wand-magic-sparkles"></i><span>Противодействие Арона</span></button>
                  </div>
                {{/if}}
              </article>
            {{/if}}

             {{#each visibleServantPhantoms}}
               <article class="bh-daily-card {{#if active}}is-active{{else}}is-locked{{/if}}">
                 <header>
                   <div><strong>{{name}}</strong><small>{{location}}</small></div>
                   <div class="bh-servant-status">
                      {{#if isRankedServant}}
                       <div class="bh-servant-level">
                         {{#if active}}
                           {{#if @root.isGM}}
                             <div class="bh-servant-level-actions">
                               <button type="button" data-action="step-servant-rank" data-servant="{{id}}" data-direction="1" title="Повысить уровень" {{#unless canIncreaseRank}}disabled{{/unless}}><i class="fa-solid fa-chevron-up"></i></button>
                               <button type="button" data-action="step-servant-rank" data-servant="{{id}}" data-direction="-1" title="Понизить уровень" {{#unless canDecreaseRank}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
                             </div>
                           {{/if}}
                         {{/if}}
                         <small>ур. {{rank}}</small>
                       </div>
                     {{/if}}
                     <span>{{#if active}}{{#if grantedToday}}Сегодня выдано{{else}}Готовы{{/if}}{{else}}Не открыты{{/if}}</span>
                   </div>
                 </header>
                 <p>{{description}}</p>
                {{#if currentProduct}}<div class="bh-current-product"><i class="fa-solid fa-cookie-bite"></i><span>{{currentProduct}}</span><small>насыщенные</small></div>{{/if}}
                {{#if recipeRows.length}}
                  <ol class="bh-recipe-order">
                    {{#each recipeRows}}
                      <li><b>{{@index}}</b><span><strong>{{name}}</strong><small>{{englishName}}</small></span><div>
                        <button type="button" data-action="move-recipe" data-servant="{{../id}}" data-recipe="{{id}}" data-direction="-1" title="Поднять в очереди" {{#unless canMoveUp}}disabled{{/unless}}><i class="fa-solid fa-chevron-up"></i></button>
                        <button type="button" data-action="move-recipe" data-servant="{{../id}}" data-recipe="{{id}}" data-direction="1" title="Опустить в очереди" {{#unless canMoveDown}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
                      </div></li>
                    {{/each}}
                  </ol>
                {{/if}}
                {{#if exhausted}}<div class="bh-ingredients-empty"><i class="fa-solid fa-basket-shopping"></i> У {{emptyLabel}} закончились ингредиенты</div>{{/if}}
                {{#if ../isGM}}{{#if exhausted}}<button type="button" class="bh-reset-ingredients" data-action="reset-servant-recipes" data-servant="{{id}}"><i class="fa-solid fa-arrow-rotate-left"></i> Восстановить готовку</button>{{/if}}{{/if}}
                <div class="bh-recipient-list">{{#each recipientSlots}}<label class="bh-recipient"><span>Получатель {{index}}</span><select data-preparation-target="{{../id}}" {{#unless ../active}}disabled{{/unless}}><option value="">— персонаж не выбран —</option>{{#each @root.recipientCharacters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>{{/each}}</div>
              </article>
            {{/each}}
          </div>
          {{#if hasCookingProviders}}<button type="button" class="bh-daily-submit" data-action="grant-daily-cooking"><i class="fa-solid fa-bowl-food"></i> Выдать ежедневную готовку</button>{{else}}<p class="bh-empty">Помощники для ежедневной готовки пока не открыты.</p>{{/if}}
        </section>

        <hr class="bh-cooking-divider">

        <section class="bh-daily-section bh-boons-section">
          <div class="bh-section-title"><i class="fa-solid fa-hands-praying"></i><div><h2>Блага</h2><p>Настройте доступные ежедневные благословения и выдайте их персонажам игроков.</p></div></div>
          <div class="bh-daily-grid">
            {{#if auskenBoon}}
              <article class="bh-daily-card is-active">
                <header><div><strong>Благословение шерифа</strong><small>Аускен Даст · ранг {{auskenBoon.rank}}</small></div><span>{{#if auskenBoon.grantedToday}}Сегодня выдано{{else}}до {{auskenBoon.maxTargets}} ПИ{{/if}}</span></header>
                <p>На 24 часа даёт бонус состояния +1 к спасброскам против страха и уменьшает Испуг на 1. С ранга 2 успех против страха становится критическим успехом.</p>
                <div class="bh-recipient-checks" data-recipient-group="ausken" data-max-targets="{{auskenBoon.maxTargets}}">{{#each recipientCharacters}}<label><input type="checkbox" value="{{id}}"> <span>{{name}}</span></label>{{/each}}</div>
              </article>
            {{/if}}

            {{#if showShelynBoon}}
              <article class="bh-daily-card {{#if data.boons.shelyn.active}}is-active{{else}}is-locked{{/if}}">
                <header><div><strong>Благодать Шелин</strong><small>C45 · одна из трёх статуй</small></div><span>{{#if data.boons.shelyn.active}}{{#if shelynGrantedToday}}Сегодня выдано{{else}}До заката{{/if}}{{else}}Не найдена{{/if}}</span></header>
                {{#if isGM}}<label class="bh-shelyn-toggle"><input type="checkbox" data-action="toggle-shelyn" {{#if data.boons.shelyn.active}}checked{{/if}}> Благо найдено и доступно игрокам</label>{{/if}}
                <label class="bh-recipient"><span>Выбранное благо</span><select data-shelyn-choice {{#unless data.boons.shelyn.active}}disabled{{/unless}}>{{#each shelynBlessings}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{spell}}</option>{{/each}}</select></label>
                <div class="bh-group-recipient"><i class="fa-solid fa-people-group"></i><span><strong>Получатели: все ПИ</strong><small>Выбранное благо автоматически применяется ко всей группе.</small></span></div>
                <p class="bh-daily-note">Выбранный бонус предмета +1 действует у всех ПИ до текущего заката — оставшееся дневное время, а не фиксированные 8 часов.</p>
              </article>
            {{/if}}
          </div>
          {{#if hasBoonProviders}}<button type="button" class="bh-daily-submit" data-action="grant-daily-boons"><i class="fa-solid fa-sparkles"></i> Выдать ежедневные блага</button>{{else}}<p class="bh-empty">Ежедневные блага пока не открыты.</p>{{/if}}
        </section>
      </div>
      {{else}}
      {{#if showInventory}}
      <div class="bh-inventory-view">
        <section class="bh-inventory-drop">
          <i class="fa-solid fa-hand-holding-heart"></i>
          <div><strong>Инвентарь Бастардхолла</strong><span>Бросьте предмет в любую область листа. Возвращённые вещи нельзя забрать обратно.</span></div>
        </section>
        <div class="bh-inventory-layout">
          <div class="bh-column">
            <section class="bh-panel">
              <h2><i class="fa-solid fa-heart-pulse"></i> Сердечники Душ</h2>
              <div class="bh-hp-total"><span>Получено ОЗ</span><strong>+{{bonusHp}}</strong><small>к максимальным ОЗ персонажей игроков</small></div>
              <div class="bh-heart-list">
                {{#each hearts}}
                  <div class="bh-heart-row"><div class="bh-heart-shape {{shape}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}</div><span>Собрано {{label}}:</span><strong>{{count}}</strong><small>+{{hp}} ОЗ</small></div>
                {{/each}}
              </div>
            </section>

            <section class="bh-panel">
              <h2><i class="fa-solid fa-gem"></i> Коллекции</h2>
              <div class="bh-collection-list">{{#each collections}}<div><span>{{label}}</span><strong>{{count}}</strong></div>{{/each}}</div>
            </section>

            <section class="bh-panel bh-memento-panel">
              <h2><i class="fa-solid fa-box-open"></i> Памятные вещи</h2>
              <div class="bh-memento-list">
                {{#each collectedMementos}}
                  <article class="bh-memento is-collected"><i class="fa-solid fa-circle-check"></i><div><strong>{{name}}</strong><small>Найдено: {{foundArea}}. Разблокирует: {{area}}.</small>{{#if displayBonus}}<p>{{displayBonus}}</p>{{/if}}</div></article>
                {{else}}
                  <p class="bh-empty">Памятные вещи ещё не возвращены.</p>
                {{/each}}
              </div>
            </section>
          </div>

          <section class="bh-panel bh-loot-panel">
            <h2><i class="fa-solid fa-box-archive"></i> Возвращённые предметы</h2>
            {{#if inventory.length}}
              <div class="bh-loot-list">
                {{#each inventory}}
                  <button type="button" class="bh-loot-item" data-action="open-inventory-item" data-uuid="{{uuid}}" title="Открыть {{name}}">
                    <img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{slug}}</small><em>{{category}}</em></span><b>×{{quantity}}</b>
                  </button>
                {{/each}}
              </div>
            {{else}}
              <p class="bh-empty">Инвентарь пока пуст.</p>
            {{/if}}
          </section>
        </div>
      </div>
      {{else}}
      {{#if showFamilyTree}}
      <div class="bh-family-tree-view">
        <header class="bh-family-tree-heading">
          <div>
            <p>Родословная владельцев Бастардхолла</p>
            <h2>Древо Арудора</h2>
          </div>
          {{#if canEditFamilyTree}}<span><i class="fa-solid fa-hand"></i> Перетащите актёра на портрет</span>{{/if}}
        </header>

        <section class="bh-family-stage" aria-label="Пять поколений семьи Арудора">
          <article class="bh-family-crest">
            <div class="bh-family-crest-image">
              <img src="modules/ts-pf2e-utility/layout/BoB/audora-family.webp" alt="Герб Арудора">
            </div>
          </article>

          <svg class="bh-family-lines" viewBox="0 0 1000 1300" preserveAspectRatio="none" aria-hidden="true">
            <g>
              <path d="M485 300 H515 M500 300 V410 H420 V435" />
              <path d="M485 520 H515 M500 520 V630 H420 V655" />
              <path d="M485 740 H515 M500 740 V850 H210 V875 M500 850 H410 V875" />
              <path d="M475 960 H515" />
              <path d="M210 1040 V1095" />
              <path d="M495 960 V1070 H410 V1095 M495 1070 H580 V1095" />
              <path d="M790 1040 V1095" />
            </g>
          </svg>

          {{#each familyTreeGenerations}}
            <div class="bh-family-shelf" style="--bh-shelf-y: {{shelfY}}px"><span>{{label}}</span></div>
          {{/each}}

          {{#each familyTreeSlots}}
            <article class="bh-family-member {{#if assigned}}is-assigned{{else}}is-empty{{/if}} {{#if crowned}}is-crowned{{/if}}" data-drop-kind="family-tree" data-family-section="slots" data-slot-id="{{id}}" style="--bh-family-x: {{xPercent}}%; --bh-family-y: {{y}}px">
              <div class="bh-family-photo">{{#if assigned}}{{#if img}}<img src="{{img}}" alt="{{name}}">{{/if}}{{/if}}</div>
              <img class="bh-family-frame" src="modules/ts-pf2e-utility/layout/BoB/audora-family-frame.png" alt="">
              {{#if crowned}}<i class="fa-solid fa-crown bh-family-crown" title="Владелец замка на момент начала проклятия"></i>{{/if}}
              <div class="bh-family-name">{{#if assigned}}{{name}}{{/if}}</div>
              {{#if assigned}}
