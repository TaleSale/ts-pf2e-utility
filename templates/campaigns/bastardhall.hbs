                     <button type="button" class="bh-sidequest-icon-button bh-sidequest-source" data-action="open-investigation-source" data-investigation-id="{{id}}" title="Открыть источник в журнале" aria-label="Открыть источник в журнале"><i class="fa-solid fa-book-open"></i></button>
                     <button type="button" class="bh-sidequest-icon-button bh-sidequest-delete" data-action="delete-investigation" data-investigation-id="{{id}}" title="Удалить изыскание" aria-label="Удалить изыскание"><i class="fa-solid fa-trash"></i></button>
                   </footer>
                 {{/if}}{{/if}}
               </article>
            {{else}}
              <p class="bh-empty">Изысканий пока нет. Откройте журнал и нажмите кнопку у заголовка <code>section.research</code>.</p>
            {{/each}}
          </div>
        </aside>

         <section class="bh-panel bh-investigation-detail{{#if selectedInvestigation.researchBonusExcluded}} is-research-bonus-excluded{{/if}}">
          {{#if selectedInvestigation}}
