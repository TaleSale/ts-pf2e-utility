                <label><span>Закат</span><input type="number" min="0" max="23.99" step="0.25" name="climate.stages.{{key}}.sunset" value="{{sunset}}"></label>
                <label><span>Описание</span><textarea rows="6" name="climate.stages.{{key}}.description">{{description}}</textarea></label>
              </fieldset>
              {{/each}}
