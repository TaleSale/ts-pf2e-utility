                <h2>{{selectedSideQuest.title}}</h2>
                {{#if selectedSideQuest.hidden}}<span class="bh-sidequest-hidden-badge"><i class="fa-solid fa-eye-slash"></i> Скрыт от игроков</span>{{/if}}
              </div>
              <button type="button" class="bh-sidequest-note-button" data-action="add-side-quest-note" data-quest-id="{{selectedSideQuest.id}}"><i class="fa-solid fa-note-sticky"></i> Добавить заметку</button>
