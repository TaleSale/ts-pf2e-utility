                </button>
                {{#if selected}}
                  <div class="bh-investigation-source-counters">
                    {{#each sources}}
                       <div class="bh-investigation-source-counter {{#unless ../../isGM}}is-player{{/unless}}">
                         <span title="{{displayName}}">{{displayName}}</span>
                        {{#if ../../isGM}}<button type="button" data-action="step-investigation-source" data-investigation-id="{{../id}}" data-source-id="{{id}}" data-step="-1" title="Уменьшить ОИ" {{#unless canDecrease}}disabled{{/unless}}><i class="fa-solid fa-caret-down"></i></button>{{/if}}
                        <strong>{{points}} / {{maxPoints}}</strong>
                        {{#if ../../isGM}}<button type="button" data-action="step-investigation-source" data-investigation-id="{{../id}}" data-source-id="{{id}}" data-step="1" title="Увеличить ОИ" {{#unless canIncrease}}disabled{{/unless}}><i class="fa-solid fa-caret-up"></i></button>{{/if}}
                      </div>
                    {{/each}}
                 </div>
                 {{/if}}
