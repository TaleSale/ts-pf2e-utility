                    {{#if ../isGM}}
                      <button type="button" class="bh-sidequest-icon-button bh-sidequest-visibility {{#if hidden}}is-hidden{{/if}}" data-action="toggle-side-quest-visibility" data-quest-id="{{id}}" title="{{#if hidden}}Показать игрокам{{else}}Скрыть от игроков{{/if}}" aria-label="{{#if hidden}}Показать игрокам{{else}}Скрыть от игроков{{/if}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
                      <button type="button" class="bh-sidequest-icon-button" data-action="edit-side-quest" data-quest-id="{{id}}" title="Редактировать сайд-квест" aria-label="Редактировать сайд-квест"><i class="fa-solid fa-pencil"></i></button>
